# Ce fichier est un exemple des variables que doit contenir le fichier .env
# Copier-Coller les noms de variables dans un fichier .env puis ajouter les valeurs des variables

# OpenAI
OPENAI_API_KEY=""

# Upstash
UPSTASH_VECTOR_REST_URL=""
UPSTASH_VECTOR_REST_TOKEN=""

# Upstash Redis (Bonus: sauvegarde des conversations)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# (Optionnel) Paramètres de sauvegarde des conversations
# Préfixe de clé dans Redis
CHAT_STORE_PREFIX="portfolio-chat:"
# Durée de conservation (en secondes). Vide = 14 jours par défaut.
CHAT_STORE_TTL_SECONDS=""